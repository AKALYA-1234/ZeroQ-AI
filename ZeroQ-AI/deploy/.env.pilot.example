# Copy to deploy/.env.pilot and fill in. NEVER commit the filled-in file (it is gitignored).
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- required -------------------------------------------------------------
SECRET_KEY=
POSTGRES_PASSWORD=

# --- database / ports ------------------------------------------------------
POSTGRES_DB=zeroq_pilot
POSTGRES_USER=zeroq
PUBLIC_PORT=8080
BACKEND_WORKERS=2

# --- LLM fallback (any subset; providers without a key are skipped) --------
# Order: LLM_PROVIDER first, then LLM_FALLBACK_PROVIDERS.
LLM_ENABLED=true
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDERS=openrouter,anthropic
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
# A model id ending in ":free" is the free tier (rate limited, no guaranteed availability).
OPENROUTER_MODEL=
ANTHROPIC_API_KEY=

# --- pilot data hygiene ----------------------------------------------------
# Submissions from these accounts are tagged "test" and excluded from real-world metrics and training.
# Exact addresses and/or whole domains. The validation scripts use @example.com accounts.
PILOT_TEST_EMAILS=demo@customer.com,@example.com

# --- business-impact assumptions (leave empty = cost saved shows N/A) ------
IMPACT_UNIT_COST_INR=
IMPACT_DOWNTIME_COST_PER_HOUR_INR=
